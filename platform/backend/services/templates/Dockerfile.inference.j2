FROM {{ base_image }}

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MODEL_NAME={{ model_name_env }} \
    MODEL_VERSION={{ version }} \
    MODEL_FRAMEWORK={{ framework }} \
    MODEL_PATH=/app/weights/{{ weights_filename }}

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn[standard] pydantic{% if framework == "pytorch" %} torch{% elif framework == "onnx" %} onnxruntime{% elif framework == "tensorflow" %} tensorflow{% endif %}
{% for req in extra_requirements %}
RUN ["pip", "install", "--no-cache-dir", {{ req | tojson }}]
{% endfor %}
{% if framework == "ridge" %}
COPY artifacts/ /app/artifacts/
COPY ridge_artifacts.py /app/ridge_artifacts.py
{% else %}
COPY weights/ /app/weights/
{% endif %}
COPY inference_server.py /app/inference_server.py
COPY model_meta.json /app/model_meta.json

# 빌드한 이미지의 실제 설치 환경에서 framework loader가 성공해야 built를 게시한다.
RUN python -c "import inference_server; inference_server._load_model()"

LABEL fed.artifact_id={{ artifact_id | tojson }} \
      fed.manifest_checksum={{ manifest_checksum | tojson }} \
      fed.weights_checksum={{ weights_checksum | tojson }}

EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8501/health').status==200 else 1)"
CMD ["uvicorn", "inference_server:app", "--host", "0.0.0.0", "--port", "8501"]
