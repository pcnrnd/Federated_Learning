"""연합학습 모델 추론 서버 (자동 생성됨 — 직접 수정 금지)"""
from __future__ import annotations

import json
import os
from pathlib import Path
from typing import Any

from fastapi import FastAPI, HTTPException
from pydantic import BaseModel

MODEL_NAME = os.environ.get("MODEL_NAME", "{{ model_name }}")
MODEL_VERSION = os.environ.get("MODEL_VERSION", "{{ version }}")
MODEL_FRAMEWORK = os.environ.get("MODEL_FRAMEWORK", "{{ framework }}")
MODEL_PATH = Path(os.environ.get("MODEL_PATH", "/app/weights/{{ weights_filename }}"))

app = FastAPI(title=f"{MODEL_NAME}@{MODEL_VERSION} inference")

_meta_path = Path("/app/model_meta.json")
_meta: dict[str, Any] = json.loads(_meta_path.read_text("utf-8")) if _meta_path.exists() else {}
_model: Any = None


def _load_model() -> Any:
    """프레임워크별 모델 로딩 — lazy"""
    global _model
    if _model is not None:
        return _model
    if MODEL_FRAMEWORK == "pytorch":
        import torch  # type: ignore[import-not-found]

        _model = torch.load(str(MODEL_PATH), map_location="cpu")
        if hasattr(_model, "eval"):
            _model.eval()
    elif MODEL_FRAMEWORK == "onnx":
        import onnxruntime  # type: ignore[import-not-found]

        _model = onnxruntime.InferenceSession(str(MODEL_PATH))
    elif MODEL_FRAMEWORK == "tensorflow":
        import tensorflow as tf  # type: ignore[import-not-found]

        _model = tf.keras.models.load_model(str(MODEL_PATH))
    else:
        raise RuntimeError(f"지원하지 않는 framework: {MODEL_FRAMEWORK}")
    return _model


class PredictRequest(BaseModel):
    inputs: list[Any]


@app.get("/health")
def health() -> dict[str, str]:
    return {"status": "ok", "model": MODEL_NAME, "version": MODEL_VERSION}


@app.get("/meta")
def meta() -> dict[str, Any]:
    return {
        "name": MODEL_NAME,
        "version": MODEL_VERSION,
        "framework": MODEL_FRAMEWORK,
        **_meta,
    }


@app.post("/predict")
def predict(payload: PredictRequest) -> dict[str, Any]:
    if not MODEL_PATH.exists():
        raise HTTPException(status_code=503, detail=f"가중치 파일 없음: {MODEL_PATH}")
    try:
        _load_model()
    except Exception as exc:  # noqa: BLE001
        raise HTTPException(status_code=500, detail=f"모델 로딩 실패: {exc}") from exc
    # 실제 추론은 사용자 모델 시그니처에 의존 — 표준 wrapper만 제공
    return {
        "ok": True,
        "input_count": len(payload.inputs),
        "note": "실제 forward pass 로직은 모델 메타데이터에 맞춰 확장하세요.",
    }
